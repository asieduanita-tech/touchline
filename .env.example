# Admin credentials are server-side only. Use a unique password.
TOUCHLINE_ADMIN_USER=owner
TOUCHLINE_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional private JSON maps used to anonymise real league CSV uploads.
# Unknown identities are automatically converted to deterministic fictional aliases.
TOUCHLINE_TEAM_ALIASES_JSON={}
TOUCHLINE_PLAYER_ALIASES_JSON={}

# Added automatically when a private Vercel Blob store is connected.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
